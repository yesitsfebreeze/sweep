// Plain default layout for the settings-reset firmware.
// Every boot wipes all stored settings (Bluetooth bonds, split pairing).

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U     &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J     &kp K      &kp L    &kp SEMI
  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH
                       &mo 1  &kp SPACE  &kp BSPC  &kp ENTER
            >;
        };

        fn_layer {
            bindings = <
  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8  &kp N9     &kp N0
  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &kp ESC     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp TAB
  &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader   &none &none &none &none &bootloader
                                  &trans    &trans      &trans    &trans
            >;
        };
    };
};
